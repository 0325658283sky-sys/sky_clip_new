{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkyCut Project",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "maxLength": 40
    },
    "input": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "youtube",
            "upload",
            "blog"
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 2000
        },
        "rightsAttested": {
          "type": "boolean"
        },
        "attestedAt": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "kind",
        "rightsAttested"
      ],
      "additionalProperties": false
    },
    "sourceAssetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "assets": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "image",
              "audio"
            ]
          },
          "variants": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "source",
                "proxy",
                "wav16k"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "원본 기준 밀리초"
          },
          "placeholder": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "talk_scene",
                  "landscape"
                ]
              },
              "palette": {
                "minItems": 2,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                }
              },
              "label": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "kind",
              "palette"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "variants"
        ],
        "additionalProperties": false
      }
    },
    "transcript": {
      "type": "object",
      "properties": {
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "원본 기준 밀리초"
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "원본 기준 밀리초"
              },
              "speakerId": {
                "type": "string",
                "maxLength": 32
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "id",
              "text",
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          }
        },
        "sentences": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "startWordId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "endWordId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "id",
              "startWordId",
              "endWordId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "words",
        "sentences"
      ],
      "additionalProperties": false
    },
    "article": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "blogName": {
          "type": "string",
          "maxLength": 100
        },
        "author": {
          "type": "string",
          "maxLength": 100
        },
        "sections": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string",
                "maxLength": 200
              },
              "paragraphs": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "imageAssetIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "required": [
              "paragraphs",
              "imageAssetIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "sections"
      ],
      "additionalProperties": false
    },
    "clips": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "content": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "video_excerpt",
                  "narrated_story"
                ]
              },
              "range": {
                "type": "object",
                "properties": {
                  "startWordId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "endWordId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "startWordId",
                  "endWordId"
                ],
                "additionalProperties": false
              },
              "scenes": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "narration": {
                      "type": "string",
                      "minLength": 1
                    },
                    "imageAssetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "textCard": {
                      "type": "string",
                      "maxLength": 60
                    }
                  },
                  "required": [
                    "id",
                    "narration"
                  ],
                  "additionalProperties": false
                }
              },
              "titles": {
                "minItems": 1,
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "line1": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "line2": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "keywordSpan": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "line1",
                    "line2"
                  ],
                  "additionalProperties": false
                }
              },
              "bottomCard": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "summary",
                      "real_comment",
                      "question"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "authorMasked": {
                    "type": "string",
                    "maxLength": 40
                  }
                },
                "required": [
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              },
              "effectMoments": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "anchorWordId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "anchorSceneId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 12
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "autoEdit": {
                "default": {
                  "fillerWordIds": [],
                  "silenceRangesMs": []
                },
                "type": "object",
                "properties": {
                  "fillerWordIds": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "silenceRangesMs": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "startMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "description": "원본 기준 밀리초"
                        },
                        "endMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "description": "원본 기준 밀리초"
                        }
                      },
                      "required": [
                        "startMs",
                        "endMs"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "fillerWordIds",
                  "silenceRangesMs"
                ],
                "additionalProperties": false
              },
              "score": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "hook": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "standalone": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "ending": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5
                  }
                },
                "required": [
                  "total",
                  "hook",
                  "standalone",
                  "ending",
                  "value"
                ],
                "additionalProperties": false
              },
              "reason": {
                "default": "",
                "type": "string",
                "maxLength": 300
              },
              "credit": {
                "type": "object",
                "properties": {
                  "channelName": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "videoTitle": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "channelName"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "scenes",
              "titles",
              "effectMoments",
              "autoEdit",
              "score",
              "reason"
            ],
            "additionalProperties": false
          },
          "appliedTemplateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "selectedTitleIndex": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "overrides": {
            "default": {
              "content": {
                "cuts": [],
                "keepWordIds": [],
                "captionText": {},
                "extraEffectMoments": []
              },
              "style": {},
              "keepStyleOnTemplateChange": false
            },
            "type": "object",
            "properties": {
              "content": {
                "default": {
                  "cuts": [],
                  "keepWordIds": [],
                  "captionText": {},
                  "extraEffectMoments": []
                },
                "type": "object",
                "properties": {
                  "cuts": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "startMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "description": "원본 기준 밀리초"
                        },
                        "endMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "description": "원본 기준 밀리초"
                        }
                      },
                      "required": [
                        "startMs",
                        "endMs"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "keepWordIds": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "captionText": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "titleOverride": {
                    "type": "object",
                    "properties": {
                      "line1": {
                        "type": "string",
                        "maxLength": 40
                      },
                      "line2": {
                        "type": "string",
                        "maxLength": 40
                      },
                      "keywordSpan": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "end": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "line1",
                      "line2"
                    ],
                    "additionalProperties": false
                  },
                  "bottomCardText": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "extraEffectMoments": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "anchorWordId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "anchorSceneId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 12
                        }
                      },
                      "required": [
                        "text"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "mediaCrop": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "w": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "h": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "w",
                      "h"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "cuts",
                  "keepWordIds",
                  "captionText",
                  "extraEffectMoments"
                ],
                "additionalProperties": false
              },
              "style": {
                "default": {},
                "type": "object",
                "properties": {
                  "titleColor": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "titleLine2Color": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "captionColor": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "captionFontScale": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2
                  },
                  "backgroundColor": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "bgmGainDb": {
                    "type": "number",
                    "minimum": -60,
                    "maximum": 6
                  },
                  "originalGainDb": {
                    "type": "number",
                    "minimum": -60,
                    "maximum": 6
                  },
                  "ttsGainDb": {
                    "type": "number",
                    "minimum": -60,
                    "maximum": 6
                  },
                  "duckingDb": {
                    "type": "number",
                    "minimum": -40,
                    "maximum": 0
                  }
                },
                "additionalProperties": false
              },
              "keepStyleOnTemplateChange": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "content",
              "style",
              "keepStyleOnTemplateChange"
            ],
            "additionalProperties": false
          },
          "generated": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "tts"
                },
                "assetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "cacheKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "sceneId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "wordTimings": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "startMs": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "description": "원본 기준 밀리초"
                      },
                      "endMs": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "description": "원본 기준 밀리초"
                      }
                    },
                    "required": [
                      "text",
                      "startMs",
                      "endMs"
                    ],
                    "additionalProperties": false
                  }
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "원본 기준 밀리초"
                }
              },
              "required": [
                "kind",
                "assetId",
                "cacheKey",
                "wordTimings",
                "durationMs"
              ],
              "additionalProperties": false
            }
          },
          "narrationDurationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "원본 기준 밀리초"
          }
        },
        "required": [
          "id",
          "content",
          "appliedTemplateId",
          "selectedTitleIndex",
          "overrides",
          "generated"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "default": {},
      "type": "object",
      "properties": {
        "llmModel": {
          "type": "string",
          "maxLength": 80
        },
        "promptVersion": {
          "type": "string",
          "maxLength": 40
        },
        "sttEngine": {
          "type": "string",
          "maxLength": 40
        },
        "ttsProvider": {
          "type": "string",
          "maxLength": 40
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "input",
    "assets",
    "clips",
    "provenance"
  ],
  "additionalProperties": false
}
