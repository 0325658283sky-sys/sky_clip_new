{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@skycut/schema": ["./packages/schema/src/index.ts"],
      "@skycut/core": ["./packages/core/src/index.ts"],
      "@skycut/templates": ["./packages/templates/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "apps/renderer/**/*.ts", "apps/renderer/**/*.tsx", "tools/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist", "out"]
}
