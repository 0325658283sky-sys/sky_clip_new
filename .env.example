# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋되지 않는다.
# 키를 채팅이나 코드에 붙여넣지 않는다.

# 하이라이트 추출·제목 생성
ANTHROPIC_API_KEY=

# STT (영상 입력) — M1 비교 실험에서 하나를 고른 뒤 적는다
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
SKYCUT_STT_ENGINE=elevenlabs

# TTS (블로그 입력 나레이션) — Typecast가 한국어 단어 타임스탬프를 준다
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
SKYCUT_TTS_PROVIDER=typecast

# 유튜브 인기 댓글 (없으면 요약 카드로 대체된다)
YOUTUBE_API_KEY=

# 비용 집계용. 공식 문서에 금액이 없어 비워 두면 $0으로 기록된다.
# 가입 후 요금 페이지에서 확인해 채운다.
ELEVENLABS_USD_PER_HOUR=
DEEPGRAM_USD_PER_MINUTE=
TYPECAST_USD_PER_1K_CHARS=
ELEVENLABS_TTS_USD_PER_1K_CHARS=

# 바꿀 일이 거의 없는 값
# SKYCUT_LLM_MODEL=claude-opus-5-5
# SKYCUT_LLM_EFFORT=high
# ELEVENLABS_STT_MODEL=scribe_v2
# DEEPGRAM_MODEL=nova-3
# TYPECAST_MODEL=ssfm-v31
